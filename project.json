{
  "id": "sijson",
  "type": "package",
  "value": {
    "author": "Suleyman Laarabi",
    "description": "A fast, easy-to-use JSON serialization and deserialization library for C23",
    "clangd": true,
    "use": ["sireflect"]
  },
  "bundle": {
    "repositories": {
      "sireflect": "https://github.com/suleymanlaarabi/sireflect"
    }
  },
  "lang.c": {
    "c-standard": "c23",
    "${os windows}": {
      "c-standard": "c11",
      "symbols": false,
      "cflags": ["/FS"]
    },
    "export-symbols": true,
    "include": ["src"]
  }
}
