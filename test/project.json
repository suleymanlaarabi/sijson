{
  "id": "sijson.test",
  "type": "application",
  "value": {
    "public": false,
    "clangd": true,
    "use": ["sijson"]
  },
  "lang.c": {
    "c-standard": "c23",
    "include": ["../src"]
  },
  "test": {
    "testsuites": [
      {
        "id": "dynamic",
        "testcases": [
          "make",
          "arena",
          "parse",
          "stringify",
          "errors"
        ]
      },
      {
        "id": "typed",
        "testcases": [
          "to_json",
          "from_json",
          "errors",
          "dynamic_value"
        ]
      },
      {
        "id": "typed_array",
        "testcases": [
          "to_json_numbers",
          "from_json_numbers",
          "roundtrip_matrix",
          "of_structs",
          "of_strings",
          "rejects_wrong_length",
          "rejects_wrong_type"
        ]
      },
      {
        "id": "typed_native_aliases",
        "testcases": [
          "to_json",
          "from_json",
          "reject_range"
        ]
      }
    ]
  }
}
