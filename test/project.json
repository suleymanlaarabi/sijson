{
  "id": "sijson.test",
  "type": "application",
  "value": {
    "public": false,
    "clangd": true,
    "use": ["sijson"]
  },
  "lang.c": {
    "c-standard": "c23",
    "include": ["../src"]
  },
  "test": {
    "testsuites": [
      {
        "id": "simple",
        "testcases": [
          "dynamic_make",
          "dynamic_arena",
          "dynamic_parse",
          "stringify",
          "dynamic_errors",
          "registry",
          "typed_to_json",
          "typed_from_json",
          "typed_errors",
          "typed_dynamic_value",
          "typed_array_to_json_numbers",
          "typed_array_from_json_numbers",
          "typed_array_roundtrip_matrix",
          "typed_array_of_structs",
          "typed_array_of_strings",
          "typed_array_rejects_wrong_length",
          "typed_array_rejects_wrong_type"
        ]
      }
    ]
  }
}
